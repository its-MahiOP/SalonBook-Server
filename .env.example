# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
DB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
DB_NAME=SalonBook

# Better Auth JWT verification (public JWKS endpoint base URL)
AUTH_JWKS_URL=http://localhost:3000

# Stripe (test mode)
# STRIPE_SECRET_KEY is required for checkout.
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET is the signing secret (whsec_...) of your webhook endpoint.
# Without it every webhook event is rejected, so appointments are never marked paid.
STRIPE_WEBHOOK_SECRET=
# Optional: reported by GET /api/payments/status
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=usd
