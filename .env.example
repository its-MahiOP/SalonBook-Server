# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
DB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
DB_NAME=SalonBook

# Better Auth JWT verification (public JWKS endpoint base URL)
AUTH_JWKS_URL=http://localhost:3000

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
